generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int     @id @default(autoincrement())
  username   String  @unique
  password   String
  email      String  @unique
  country    String
  gender     String
  newsletter Boolean @default(false)
  role       Role    @default(USER)

  reviews  Review[]
  images   Image[]
  videos   Video[]
  stories  Story[]
  chapters Chapter[]
  posts    Post[]

  comments Comment[]
  likes    Like[]
}

model Post {
  id         Int      @id @default(autoincrement())
  title      String
  content    String
  uploadedAt DateTime @default(now())

  user   User @relation(fields: [userId], references: [id])
  userId Int
}

model Image {
  id         Int      @id @default(autoincrement())
  caption    String
  url        String
  uploadedAt DateTime @default(now())

  user   User @relation(fields: [userId], references: [id])
  userId Int
}

model Video {
  id         Int      @id @default(autoincrement())
  caption    String
  url        String
  uploadedAt DateTime @default(now())

  user       User @relation(fields: [userId], references: [id])
  userId     Int
}

model Story {
  id      Int    @id @default(autoincrement())
  title   String
  imgUrl  String
  summary String
  tags    String
  status  String @default("ongoing")

  reviews  Review[]
  chapters Chapter[]

  user   User @relation(fields: [userId], references: [id])
  userId Int
}

model Review {
  id         Int      @id @default(autoincrement())
  title      String
  rate       Int      @default(0)
  content    String
  uploadedAt DateTime @default(now())

  story   Story @relation(fields: [storyId], references: [id])
  storyId Int

  user   User @relation(fields: [userId], references: [id])
  userId Int
}

model Chapter {
  id         Int      @id @default(autoincrement())
  title      String
  content    String
  uploadedAt DateTime @default(now())

  story   Story @relation(fields: [storyId], references: [id])
  storyId Int

  user   User @relation(fields: [userId], references: [id])
  userId Int
}

model Comment {
  id         Int      @id @default(autoincrement())
  content    String
  uploadedAt DateTime @default(now())

  user   User @relation(fields: [userId], references: [id])
  userId Int

  likes Like[]

  commentableId   Int
  commentableType EntityType

  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  parentId Int?
  replies  Comment[] @relation("CommentReplies")
}

model Like {
  id     Int  @id @default(autoincrement())
  user   User @relation(fields: [userId], references: [id])
  userId Int

  likeableId   Int
  likeableType EntityType
  createdAt    DateTime   @default(now())
  Comment      Comment?   @relation(fields: [commentId], references: [id])
  commentId    Int?
}

enum EntityType {
  IMAGE
  VIDEO
  CHAPTER
  STORY
  REVIEW
  POST
}

enum Role {
  USER
  ADMIN
  SPONSOR
  FAN
}
